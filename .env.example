# API Configuration
API_KEY=your-secret-api-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Backblaze B2 Configuration
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key

# Worker Configuration (use 1 on free/low-memory tiers e.g. Render free 512MB)
MAX_CONCURRENT_JOBS=1
CONCURRENT_CHUNKS=1  # Chunks transcribed at a time per job (1 = minimal disk/RAM)
CHUNK_DURATION_SECONDS=600  # Length of each chunk in seconds; increase (e.g. 900) for fewer files
#TEST
# Testing (optional)
BASE_URL=http://localhost:8000
