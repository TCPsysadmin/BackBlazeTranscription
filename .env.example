# API Configuration
API_KEY=your-secret-api-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Backblaze B2 credentials are NOT configured server-side.
# They are supplied per-request in the API body (b2_key_id, b2_application_key fields)
# so the same backend can serve multiple B2 accounts.

# Worker Configuration (use 1 on free/low-memory tiers e.g. Render free 512MB)
MAX_CONCURRENT_JOBS=1
CONCURRENT_CHUNKS=1  # Chunks transcribed at a time per job (1 = minimal disk/RAM)
CHUNK_DURATION_SECONDS=600  # Length of each chunk in seconds; increase (e.g. 900) for fewer files

# CORS — allowed origins for browser frontend (comma-separated, or * for all)
# e.g. CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=*

# Temp Storage (Render persistent SSD mount)
# Worker writes all in-flight job files to {TEMP_STORAGE_DIR}/transcription_work
# and clears that subdir on boot. Falls back to system temp if the path doesn't exist.
TEMP_STORAGE_DIR=/data
#TEST
# Testing (optional)
BASE_URL=http://localhost:8000
